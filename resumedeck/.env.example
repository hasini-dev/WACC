# Supabase (auth + resume bucket)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=              # sb_secret_… — server/workers only, never NEXT_PUBLIC. Lets the worker list the bucket.
RESUME_BUCKET=resumes                   # one folder per job
# RESUME_SOURCE=local:tests/fixtures/bucket   # use a local folder instead of the bucket (offline demo)
SEED_RECRUITER_EMAIL=                   # becomes the org admin; signs in by magic link
COMPANY_NAME=Brightline Payroll
RESUME_POLL_INTERVAL_MS=10000

# LLM for structured extraction (free option: Ollama). LLM_PROVIDER=none uses heuristics only.
LLM_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com          # or http://localhost:11434 for a local model
OLLAMA_MODEL=gemma4:31b                 # cloud name; locally e.g. gemma4:12b
OLLAMA_API_KEY=                         # only for Ollama cloud

# Prototype storage (SQLite). Defaults to ./.data
# DATA_DIR=

# Later phases
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ENCRYPTION_KEY=                         # 32-byte base64, for ATS credentials
SHOW_MATCH_SCORES=false
GREENHOUSE_WEBHOOK_SECRET=
LEVER_WEBHOOK_SECRET=
DATABASE_URL=                           # optional: Postgres URI for npm run db:migrate (Supabase schema)
